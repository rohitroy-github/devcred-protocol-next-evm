# MongoDB connection used by the event listener and database maintenance scripts
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=devcred

# Sepolia WebSocket endpoint used by the event listener
# Get your Alchemy WebSocket URL from https://www.alchemy.com/
SEPOLIA_ALCHEMY_WS_URL=wss://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Deployed Sepolia contract addresses required by the event listener
DEVCRED_ESCROW_ADDRESS=your_deployed_escrow_contract_address
DEVCRED_PROFILE_ADDRESS=your_deployed_profile_contract_address
